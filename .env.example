# =============================================================================
# Fully Offline Multimodal RAG System — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.

# --- Application ---
APP_NAME=Multimodal RAG System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Mock Mode (opt-in only) ---
# When true, generates fake embeddings/transcriptions instead of using real models.
# ONLY for demo purposes when ML models are not available.
ENABLE_DEMO_MOCK_MODE=false

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=multimodal_rag

# --- Ollama (for LLaVA image descriptions) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# --- Embedding Models ---
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# --- Whisper (Audio Transcription) ---
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Storage Paths ---
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
DATABASE_URL=sqlite:///data/app.db

# --- Chunking ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
